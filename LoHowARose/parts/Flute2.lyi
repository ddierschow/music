\include "config.lyi"

fluteTwoDyn = {

  s1*3 |

  % 4
  s1\mf |
  s1*16 |

  % 21
  s1*17 |
  s2 |

  % 39
  s1\mp |
  s1*3 |
}


fluteTwoMks = {}


fluteTwoCues = {}


fluteTwoScor = {}


fluteTwoNotes = {

  R1*3

  % 4 a
  a2 a4 f |
  f4 f e2 |
  d2 d |
  c4 c d4. a8 |
  c4 c c2 |
  R1*7 |
  r4 e g f |
  f4 f e2 |
  d2 d |
  f4 d e f~ |
  f4 c c2 |

  % 21
  R1*5 |
  a'2 a4 f |
  f4 f e2 |
  d2 d |
  c4 c d4. a8 |
  c4 c c2 |
  R1*4 |
  r2 d |
  f4 d e f~ |
  f4 c f f |
  a4 a |

  % 39
  c2 f |
  d2 bes |
  c1 |
  r1 |
}


fluteTwoScore  = \transpose c \concertKey \relative c''' { << \tc \base \fluteTwoNotes \fluteTwoScor \fluteTwoDyn >> }
fluteTwoCond   = \transpose c \concertKey \relative c''' { << \tc \base \fluteTwoNotes \fluteTwoScor \fluteTwoMks >> }
fluteCTwoScore = \fluteTwoScore
fluteCTwoPart  = \transpose c \concertKey \relative c''' { << \tc \base \fluteTwoNotes \fluteTwoCues \fluteTwoDyn >> }
