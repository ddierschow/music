tubaDyn = {

  s1\mp |
  s1*2 |

  % 4
  s1\mf |
  s1*16 |

  % 21
  s1*17 |
  s2 |

  % 39
  s1\mp |
  s1*2 |
  s4\> s2 s4\! |
}


tubaMks = {}


tubaCues = {}


tubaScor = {}


tubaNotes = {

  g''1 |
  a1 |
  c1 |

  % 4 b
  f,2 f4 f |
  bes4 f c2 |
  d2 bes' |
  f4 e d2 |
  c2 f |
  R1*5 |
  r4 f g a |
  f4 g c8 d e4 |
  r4 c e f |
  bes,4 f' c2 |
  d2 g, |
  a4 bes c2 |
  c2 f, |

  % 21
  f2 f4 f |
  bes4 f c2 |
  d2 bes' |
  f4 e d2 |
  c2 f |
  f2 f4 f |
  bes4 f c2 |
  d2 bes' |
  f4 e d2 |
  c2 f |
  R1*2 |
  r4 c' e f |
  bes,4 f' c2 |
  d2 g, |
  a4 bes c2 |
  c2 f,4 f |
  f4 c' |

  % 39
  aes2 bes |
  d2 ees |
  f1 |
  f1 |
}


tubaScore        = \transpose c \concertKey \relative c,, { << \bc \base \tubaNotes \tubaScor \tubaDyn >> }
tubaCond         = \transpose c \concertKey \relative c,, { << \bc \base \tubaNotes \tubaScor \tubaMks >> }
tubaCScore       = \tubaScore
tubaCPart        = \transpose c \concertKey \relative c,, { << \bc \base \tubaNotes \tubaCues \tubaDyn >> }
stringbassScore  = \transpose c \concertKey \relative c,  { << \bc \base \tubaNotes \tubaScor \tubaDyn >> }
stringbassCond   = \transpose c \concertKey \relative c,  { << \bc \base \tubaNotes \tubaScor \tubaMks >> }
stringbassCScore = \stringbassScore
stringbassCPart  = \transpose c \concertKey \relative c,  { << \bc \base \tubaNotes \tubaCues \tubaDyn >> }
