\include "config.lyi"

trumThreeDyn = {

  s1*3 |

  % 4
  s1\mf |
  s1*16 |

  % 21
  s1*17 |
  s2 |

  % 39
  s1\mp |
  s1*3 |
}


trumThreeMks = {}


trumThreeCues = {}


trumThreeScor = {}


trumThreeNotes = {

  R1*3 |

  % 4 t
  c,2 c4 a |
  bes4 a' g2 |
  f2 f |
  a,4 c bes a~ |
  a4 g a2 |
  R1*7 |
  r4 g' g a |
  bes,4 a g2 |
  fis2 g |
  c4 bes a2 |
  g2 a |

  % 21
  c2 c4 a |
  bes4 a' g2 |
  f2 f |
  a,4 c bes a~ |
  a4 g a2 |
  R1*7 |
  r4 g' g a |
  bes,4 a g2 |
  fis2 g |
  c4 bes a2 |
  g2 a4 f |
  f'4 f |

  % 39
  f2 bes |
  f2 ees |
  a1 |
  r1 |
}


trumpetThreeScore    = \transpose c   \concertKey \relative c''' { << \tc \base \trumThreeNotes \trumThreeScor \trumThreeDyn >> }
trumpetThreeCond     = \transpose c   \concertKey \relative c''' { << \tc \base \trumThreeNotes \trumThreeScor \trumThreeMks >> }
trumpetBesThreeScore = \transpose bes \concertKey \relative c''' { << \tc \base \trumThreeNotes \trumThreeScor \trumThreeDyn >> }
trumpetBesThreePart  = \transpose bes \concertKey \relative c''' { << \tc \base \trumThreeNotes \trumThreeCues \trumThreeDyn >> }
