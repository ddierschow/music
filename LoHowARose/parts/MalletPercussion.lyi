\include "config.lyi"

malletDyn = {

  s1*3 |

  % 4
  s1\mf |
  s1*16 |

  % 21
  s1*17 |
  s2 |

  % 39
  s1\mp |
  s1*3 |
}


malletMks = {}


malletCues = {}


malletScor = {}


malletNotes = {

  R1*3 |

  % 4 s
  c2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  c'2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  r4 a g e |
  f4 d c2 |
  r4 c' c c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |

  % 21
  c'2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  c'2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  r4 a g e |
  f4 d c2 |
  r4 c' c c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f f |
  a4 c |

  % 39
  ees2 d |
  bes2 g |
  f1 |
  r1 |
}


malletpercScore  = \transpose c \concertKey \relative c'' { << \tc \base \malletNotes \malletScor \malletDyn >> }
malletpercCond   = \transpose c \concertKey \relative c'' { << \tc \base \malletNotes \malletScor \malletMks >> }
malletpercCScore = \malletpercScore
malletpercCPart  = \transpose c \concertKey \relative c'' { << \tc \base \malletNotes \malletCues \malletDyn >> }
