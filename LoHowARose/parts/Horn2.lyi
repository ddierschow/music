hornTwoDyn = {

  s1*3 |

  % 4
  s1\mf |
  s1*16 |

  % 21
  s1*17 |
  s2 |

  % 39
  s1\mp |
  s1*3 |
}


hornTwoMks = {}


hornTwoCues = {}


hornTwoScor = {}


hornTwoNotes = {

  R1*3 |

  % 4 a
  a2 a4 f |
  f4 f e2 |
  d2 d |
  c4 c d4. a8 |
  c4 c c2 |
  a'2 a4 f |
  f4 f e2 |
  d2 d |
  c4 c d4. a8 |
  c4 c c2 |
  R1*4 |
  r2 d |
  f4 d e f~ |
  f4 c c2 |

  % 21
  a'2 a4 f |
  f4 f e2 |
  d2 d |
  c4 c d4. a8 |
  c4 c c2 |
  R1*5 |
  r4 f d c |
  c4 b c2 |
  R1*2 |
  r2 d |
  f4 d e f~ |
  f4 c f f |
  a4 a |

  % 39
  c,2 f |
  d2 bes |
  c1 |
  r1 |
}


hornTwoScore  = \transpose c \concertKey \relative c''' { << \tc \base \hornTwoNotes \hornTwoScor \hornTwoDyn >> }
hornTwoCond   = \transpose c \concertKey \relative c''' { << \tc \base \hornTwoNotes \hornTwoScor \hornTwoMks >> }
hornFTwoScore = \transpose f \concertKey \relative c''' { << \tc \base \hornTwoNotes \hornTwoScor \hornTwoDyn >> }
hornFTwoPart  = \transpose f \concertKey \relative c''' { << \tc \base \hornTwoNotes \hornTwoCues \hornTwoDyn >> }
