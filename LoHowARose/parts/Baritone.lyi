baritoneScore    = \transpose c   \concertKey \relative c, { << \bc \base \baritoneNotes \baritoneScor \baritoneDyn >> }
baritoneCond     = \transpose c   \concertKey \relative c, { << \bc \base \baritoneNotes \baritoneScor \baritoneMks >> }
baritoneCScore   = \baritoneScore
baritoneCPart    = \transpose c   \concertKey \relative c, { << \bc \base \baritoneNotes \baritoneCues \baritoneDyn >> }
baritoneBesScore = \transpose bes \concertKey \relative c' { << \tc \base \baritoneNotes \baritoneScor \baritoneDyn >> }
baritoneBesPart  = \transpose bes \concertKey \relative c' { << \tc \base \baritoneNotes \baritoneCues \baritoneDyn >> }
