\include "config.lyi"

baritoneDyn = {

  s1\mp |
  s1*2 |

  % 4
  s1\mf |
  s1*16 |

  % 21
  s1*17 |
  s2 |

  % 39
  s1\mp |
  s1*2 |
  s4\>s2 s4\! |
}


baritoneMks = {}


baritoneCues = {}


baritoneScor = {}


baritoneNotes = {

  bes''1 |
  a1 |
  g1 |

  % 4 s
  c2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  R1*5 |
  r4 a g e |
  f4 d c2 |
  R1*2 |
  r2 bes |
  a4 g2 f4~ |
  f4 e f2 |

  % 21
  R1*5 |
  c'2 c4 c |
  d4 c c2 |
  a2 bes |
