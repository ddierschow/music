clarOneDyn = {

  s1*3 |

  % 4
  s1\mf |
  s1*13 |
  s2 s2\> |
  s1 |
  s2 s2\!\mp |

  % 21
  s1*5 |
  s1\mf |
  s1*8 |
  s2 s4\> s4 |
  s1 |
  s2 s4\!\mp s4\< |
  s2 |

  % 39
  s1\!\f\> |
  s1 |
  s1\!\mp |
  s1 |
}


clarOneMks = {}


clarOneCues = {}


clarOneScor = {}


clarOneNotes = {

  R1*3 |

  % 4 s
  c2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  c'2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  R1*2 |
  r4 c' c c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |

  % 21
  R1*5 |
  c'2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  r4 a g e |
  f4 d c2 |
  R1*2 |
  r2 bes' |
  a4 g2 f4~ |
  f4 e f f |
  a4 c |

  % 39
  ees2 d |
  bes2 g |
  f1 |
  r1 |
}


clarOneScore    = \transpose c   \concertKey \relative c''' { << \tc \base \clarOneNotes \clarOneScor \clarOneDyn >> }
clarOneCond     = \transpose c   \concertKey \relative c''' { << \tc \base \clarOneNotes \clarOneScor \clarOneMks >> }
clarBesOneScore = \transpose bes \concertKey \relative c''' { << \tc \base \clarOneNotes \clarOneScor \clarOneDyn >> }
clarBesOnePart  = \transpose bes \concertKey \relative c''' { << \tc \base \clarOneNotes \clarOneCues \clarOneDyn >> }
