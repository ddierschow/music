  s1*3 |
}


hornOneMks = {}


hornOneCues = {}


hornOneScor = {}


hornOneNotes = {

  R1*3 |

  % 4 s
  c,2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  c'2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  R1*4 |
  r2 bes |
  a4 g2 f4~ |
  f4 e f2 |

  % 21
  c'2 c4 c |
  d4 c c2 |
  a2 bes |
  a4 g2 f4~ |
  f4 e f2 |
  R1*5 |
  r4 a' g e |
  f4 d c2 |
