hornOneScore  = \transpose c \concertKey \relative c''' { << \tc \base \hornOneNotes \hornOneScor \hornOneDyn >> }
hornOneCond   = \transpose c \concertKey \relative c''' { << \tc \base \hornOneNotes \hornOneScor \hornOneMks >> }
hornFOneScore = \transpose f \concertKey \relative c''' { << \tc \base \hornOneNotes \hornOneScor \hornOneDyn >> }
hornFOnePart  = \transpose f \concertKey \relative c''' { << \tc \base \hornOneNotes \hornOneCues \hornOneDyn >> }
