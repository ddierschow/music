altosaxTwoScore    = \transpose c   \concertKey \relative c''' { << \tc \base \altosaxTwoNotes \altosaxTwoScor \altosaxTwoDyn >> }
altosaxTwoCond     = \transpose c   \concertKey \relative c''' { << \tc \base \altosaxTwoNotes \altosaxTwoScor \altosaxTwoMks >> }
altosaxEesTwoScore = \transpose ees \concertKey \relative c''' { << \tc \base \altosaxTwoNotes \altosaxTwoScor \altosaxTwoDyn >> }
altosaxEesTwoPart  = \transpose ees \concertKey \relative c''' { << \tc \base \altosaxTwoNotes \altosaxTwoCues \altosaxTwoDyn >> }
