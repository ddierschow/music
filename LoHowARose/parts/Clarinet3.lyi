clarThreeDyn = {

  s1*3 |

  % 4
  s1\mf |
  s1*13 |
  s2 s2\> |
  s1 |
  s2 s2\!\mp |

  % 21
  s1*5 |
  s1\mf |
  s1*8 |
  s2 s4\> s4 |
  s1 |
  s2 s4\!\mp s4\< |
  s2 |

  % 39
  s1\!\f\> |
  s1 |
  s1\!\mp |
  s1 |
}


clarThreeMks = {}


clarThreeCues = {}


clarThreeScor = {}


clarThreeNotes = {

  R1*3 |

  % 4 t
  c,2 c4 a |
  bes4 a' g2 |
  f2 f |
  a,4 c bes( a)~ |
  a4 g a2 |
  c2 c4 a |
  bes4 a' g2 |
  f2 f |
  a,4 c bes( a)~ |
  a4 g a2 |
  R1*2 |
  r4 g' g a |
  bes,4 a g2 |
  fis2 g |
  c4 bes a2 |
  g2 a |

  % 21
  R1*5 |
  c2 c4 a |
  bes4 a' g2 |
  f2 f |
  a,4 c bes( a)~ |
  a4 g a2 |
  r4 c bes a |
  a4 g e8( f g4) |
  R1*2 |
  r2 g |
  c4 bes a2 |
  g2 a4 f |
  f'4 f |

  % 39
