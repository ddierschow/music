\include "config.lyi"

clarThreeDyn = {

  s1*3 |

  % 4
  s1\mf |
  s1*16 |

  % 21
  s1*17 |
  s2 |

  % 38
  s1\mp |
  s1*3 |
}


clarThreeMks = {}


clarThreeCues = {}


clarThreeScor = {}


clarThreeNotes = {

  R1*3 |

  % 4 t
  c,2 c4 a |
  bes4 a' g2 |
  f2 f |
  a,4 c bes a~ |
  a4 g a2 |
  R1*7 |
  r4 g' g a |
  bes,4 a g2 |
  fis2 g |
  c4 bes a2 |
  g2 a |

  % 21
  R1*5 |
  c2 c4 a |
  bes4 a' g2 |
  f2 f |
  a,4 c bes a~ |
  a4 g a2 |
  R1*4 |
  r2 g |
  c4 bes a2 |
  g2 a4 f |
  f'4 f |

  % 39
  f2 bes |
  f2 ees |
  a1 |
  r1 |
}


clarThreeScore    = \transpose c   \concertKey \relative c''' { << \tc \base \clarThreeNotes \clarThreeScor \clarThreeDyn >> }
clarThreeCond     = \transpose c   \concertKey \relative c''' { << \tc \base \clarThreeNotes \clarThreeScor \clarThreeMks >> }
clarBesThreeScore = \transpose bes \concertKey \relative c''' { << \tc \base \clarThreeNotes \clarThreeScor \clarThreeDyn >> }
clarBesThreePart  = \transpose bes \concertKey \relative c''' { << \tc \base \clarThreeNotes \clarThreeCues \clarThreeDyn >> }
