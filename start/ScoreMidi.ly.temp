\version "@version@"

instrument = "@ensemble@"

\include "config.lyi"
\include "score.lyi"

\book
{
  \score
  {
    \unfoldRepeats
    <<
      \tempomark
@blob@
    >>
    \midi
    {
      \context {
        \Score
        midiMinimumVolume = #0.2
        midiMaximumVolume = #0.5
      }
    }
  }
}
