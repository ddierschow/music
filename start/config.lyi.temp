concertKey = @concertkey@
tempomark = { \tempo @tempomark@ }

RM_A = "9"

workTitle = "Work Title"
workSubtitle = ""
workOwner = "Dean Dierschow"
workEmail = "deandierschow@gmail.com"
workPerformer = "@ensemble@"
workComposer = ""
