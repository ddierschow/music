stanzaFirst = \lyricmode {
  \skip1 |
  \skip2..
  \set stanza = "1. "
  When8 |

  % 5
  \repeat volta 4 {
    I8 was born and ta- ken home all | snug-8 gled close and warm4. I8 |
    did-8 n't know at all that there were | de-8 fects in my form4. The8 |
    years8 and all they brought to me have | left8 their marks be- hind4. But8 |
    if8 some- one can love me still I'm | sure8 that I won't mind2 |
    \skip4 I8 can on- ly wish4 | some-8 one4 will8 know just how I |
    feel4. And8 love me when I'm | shab-8 by quite e- nough to make me |
  }
  \alternative {
    {
      real1 |
      \skip2..
      \set stanza = "2. "
      I've8
    }
    {
      \time 2/4
      \skip2 |
      \time 4/4
      \set stanza = "4. "
      \skip4 I8 can on- ly hope that | some-8 one4 will8 know just how you |
      feel4. And8 love you though you're | shab-8 by quite e- nough to make you |
    }
  }
  real1 |
  \skip1*2 |
}

stanzaOthers = \markup {
\fontsize #-0.5
  \fill-line {
    \hspace #0.1
    \column {
      \line { \bold "2."
        \column {
          "I've often heard the stories of the ones that love made real"
          "And often I have thought that I would someday learn to feel"
          "I sit here only watching at the borders of my life"
          "And the fear of never being loved has pierced me like a knife"
          "I can only wish someone will know just how I feel"
          "And love me when I'm shabby quite enough to make me real"
        }
      }
      \vspace #1.0
      \line { \bold "3."
        \column {
          "Now someone special in my life has made my wish occur"
          "In spite of my misshapen form and shabby worn-out fur"
          "I know that I am loved each time I see that someone's eyes"
          "They tell me I am real in ways that nothing can disguise"
          "And I have got my wish for someone who knows just how I feel"
          "He's loved me though I'm shabby quite enough to make me real"
        }
      }
      \vspace #1.0
    }
    \hspace #0.1
    \column {
      \line { \bold "4."
        \column {
          "Now all you ladies worried 'cause your shape is not quite true"
          "And all you men with loved-off fur and scalp that's showing through"
          "And all you minds with failing seams and fear where all can see"
          "Take heart from this true lesson from a worn-out shabby me"
          "And I can only hope that someone will know just how you feel"
          "And love you though you're shabby quite enough to make you real"
          "I can only hope that someone will know just how you feel"
          "And love you though you're shabby quite enough to make you real"
        }
      }
    }
    \hspace #0.1
  }
}


% final assembly for the scores to use

outline     = \pageMarks
chordsPart  = \relative c   { << \scoreConfig \chordsNotes >> }
sopranoPart = \relative c'' { << \scoreConfig \sopranoNotes \sopranoDyn >> }
sopranoMidi = \relative c'' { << \scoreConfig \sopranoNotes \sopranoDyn >> }
altoPart    = \relative c'  { << \scoreConfig \altoNotes \altoDyn >> }
altoMidi    = \relative c'  { << \scoreConfig \altoNotes \altoDyn >> }
tenorPart   = \relative c'' { << \scoreConfig \tenorNotes \tenorDyn >> }
tenorMidi   = \relative c   { << \scoreConfig \tenorNotes \tenorDyn >> }
bassPart    = \relative c'  { << \scoreConfig \bassNotes \bassDyn >> }
bassMidi    = \relative c,  { << \scoreConfig \bassNotes \bassDyn >> }
lyricPart   = \stanzaFirst
stanzaPart  = \stanzaOthers
rightPart   = << \clef treble \outline \partCombine \sopranoPart \altoPart >>
leftPart    = << \clef bass \partCombine \tenorPart \bassPart >>
concertKey  = c
keyCB       = c,,
keyCT       = c
keyFT       = f
keyBT       = bes,
keyET       = ees
