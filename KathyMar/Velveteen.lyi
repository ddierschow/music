    d2:sus4 g2 |
    c2 d2:m |
    e2:7 a2:m |
    d2:m c2 |
    g2 c2 |
    c2 d2:m |
    c2 e2:7 |
    a2:m f2 |
    c2 g2 |
  }
  \alternative {
    {
