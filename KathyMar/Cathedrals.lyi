\include "layout.lyi"

#(set-global-staff-size 15)
tempomark = { \tempo 4 = 160 }

SongHeader = \header {
  title = "Cathedrals"
  composer = "Words and music by Kathy Mar"
  arranger = \markup { \italic "arr. Dean Dierschow" }
  copyright = \markup { \teeny "Words and music (c) 2002 by Kathy Mar.  Arrangement (c) 2024 by Dean Dierschow" }
  instrument = \instrument
  meter = "Vivace"
  footer = ""
  tagline = ""
}

scoreConfig = {
  #(set-accidental-style 'modern)
  \override MultiMeasureRest.expand-limit = #2
  \override Score.PaperColumn.keep-inside-line = ##t
  \override Score.NonMusicalPaperColumn.keep-inside-line = ##t
  \time 3/4
  \key e \minor
}

pageMarks = {
  % intro
  s2.*4 |

  \textMark "Verse"
  \repeat volta 5 {
    s2.*20 |
  }
  \alternative {
    {
      s2.*18 |
    }
    {
      s2.*7 |
    }
  }

  s2.*21 |
  \bar "|."
}

chordsNotes = \chordmode {
  \repeat unfold 4 { e2.:m | }

  % verse
  \repeat volta 5 {
    e2.:m | d2. | c2. | e2.:m |
    c2. | d2. | c2. | d2. |
    e2.:m | d2. | c2. | e2.:m |
    c2. | d2. | c2. | d2. |
    g2. | g2. | d2. | d2. |
  }
  \alternative {
    {
      e2.:m | d2. |
      c2. | b2.:7 |
      e2.:m | d2. | c2. | e2.:m |
      c2. | d2. | e2.:m | s2. |
      s2.*6 |
    }
    {
      e2.:m | d2. |
      c2. | b2.:7 |
      b2.:7 | b2.:7 | b2.:7 |
    }
  }
  e2.:m | d2. |
  c2. | e2.:m |
  c2. | d2. | e2.:m | e2.:m |
  e2.:m | d2. |
  c2. | e2.:m |
  c2. | d2. | e2.:m | e2.:m |
  s2.*7 |
}

