stanzaFirst = \lyricmode {
  \skip2.*3 |
  \set stanza = "1. "
  \skip2 I4 |

  % 5
  went4 down2 | to4 the Ca- | the- dral of | War As the |
  gen-4 er- "als'" | ser- vice was | en-2. | ding4 And I |
  asked2 a4 | gen- er- al | "\"What" is the | "point?\"" 'Cause it |
  looked4 like a | game of pre- | ten-2. | ding4 And he |
  frowned2 and4 | sput- tered and | stamp- ing his | foot Said, "\"Young" |
  wo-4 man, it's | no game at | all2. | \skip4 And4 his |
  words4 were all | dag- gers and | knives And the | look in his |
  eyes4 was a | ter- ri- ble | wall2. | \skip2. |
  \skip2.*6 |

  heart4 will lie | emp-4 ty and | cold2. | \skip2. | \skip2. | \skip2. |
  \skip2 But8 the | love4 that I | give4 will live | on4 Like the |
  light4 of a | dawn4 made of | amb-4 er and | gold2. |
  \skip2 The4 | love4 that I | give4 will live | on4 Like the |
  light4 of a | dawn4 made of | amb-4 er and | gold2. |
  \skip2.*6 |
}

stanzaOthers = \markup {
  \fill-line {
    \hspace #0.1
    \column {
      \line { \bold "2."
        \column {
          "I went down to the Cathedral of Time"
          "To pray for a better tomorrow"
          "And I lit a candle to burn at both ends"
          "Just to light up my chasm of sorrow"
          "And the minutes and seconds were scattered about"
          "But they kept slipping right through my hands"
          "And the tide washed them into the past"
          "Flowing out of a castle of hourglass sands"
        }
      }
      \vspace #1.0
      \line { \bold "3."
        \column {
          "I went down to the Cathedral of Song"
          "To polish the trumpets of treason"
          "And I stood in the aisle and answered the call"
          "Of a songbird who sang out of season"
          "And I shouted of honor and beauty and truth"
          "In the eyes of each woman and man"
          "And I spoke of the gifts we are blind to in youth"
          "Which we find at the heart of the Plan"
        }
      }
    }
    \hspace #0.1
    \column {
      \line { \bold "4."
        \column {
          "I went down to the Cathedral of Death"
          "But the Well of the Souls had run dry"
          "And I knelt with the penitents praying and pale"
          "And I stood with the ghost of a sigh"
          "And the carousel horses and caravan gypsies"
          "Were dancing away out the door"
          "And the honey of hope fell in strings"
          "From the tips of my fingers and dropped on the floor"
        }
      }
      \vspace #1.0
      \line { \bold "5."
        \column {
          "I never go to Cathedrals at all"
          "Or at least any more than I must"
          "And I know when my moment of dancing is done"
          "I'll dissolve into starlight and dust"
          "And the lessons I've learned"
          "Will be lost in the night"
          "And my heart will lie empty and cold"
          "But the love that I give will live on"
          "Like the light of a dawn made of amber and gold"
          "The love that I give will live on"
          "Like the light of a dawn made of amber and gold"
        }
      }
    }
    \hspace #0.1
  }
}


% final assembly for the scores to use

outline     = \pageMarks
chordsPart  = \relative c   { << \scoreConfig \chordsNotes >> }
sopranoPart = \relative c'  { << \scoreConfig \sopranoNotes \sopranoDyn >> }
sopranoMidi = \relative c'' { << \scoreConfig \sopranoNotes \sopranoDyn >> }
altoPart    = \relative c'  { << \scoreConfig \altoNotes \altoDyn >> }
altoMidi    = \relative c'  { << \scoreConfig \altoNotes \altoDyn >> }
tenorPart   = \relative c'' { << \scoreConfig \tenorNotes \tenorDyn >> }
tenorMidi   = \relative c   { << \scoreConfig \tenorNotes \tenorDyn >> }
bassPart    = \relative c'  { << \scoreConfig \bassNotes \bassDyn >> }
bassMidi    = \relative c,  { << \scoreConfig \bassNotes \bassDyn >> }
lyricPart   = \stanzaFirst
stanzaPart  = \stanzaOthers
rightPart   = << \clef treble \outline \partCombine \sopranoPart \altoPart >>
leftPart    = << \clef bass \partCombine \tenorPart \bassPart >>
concertKey  = c
keyCB       = c,,
keyCT       = c
keyFT       = f
keyBT       = bes,
keyET       = ees
