\include "layout.lyi"

tempomark = { \tempo 4 = 80 }

SongHeader = \header {
  title = "Edward"
  composer = "Words and music by Kathy Mar"
  arranger = \markup { \italic "arr. Dean Dierschow" }
  copyright = \markup { \teeny "Words and music (c) 1994 by Kathy Mar.  Arrangement (c) 2024 by Dean Dierschow" }
  instrument = \instrument
  meter = "Adagio"
  footer = ""
  tagline = ""
}

scoreConfig = {
  #(set-accidental-style 'modern)
  \override MultiMeasureRest.expand-limit = #2
  \override Score.PaperColumn.keep-inside-line = ##t
  \override Score.NonMusicalPaperColumn.keep-inside-line = ##t
  \time 4/4
  \key c \major
}

pageMarks = {
  % intro
  s1*8 |

  \repeat volta 3 {
    % verse
    \mark \markup \bold "Verse"
    s1*10 |

    % chorus
    \mark \markup \bold "Chorus"
    s1*16 |
  }

% coincides with the end of the volta so unneccessary
%  \bar "|."
}

chordsNotes = \chordmode {
  \repeat unfold 4 { c1 | d1:m | }

  \repeat volta 3 {
    % verse
    a1:m |
    d1:m |
    bes1 |
    d1:m |
    a1:m |
    d1:m |
    bes1 |
    d1:7sus4 |
    g2 g2:sus4 |
    g1 |

    % chorus
    c1:9 |
    d2:7sus4 d2:m |
    g1 |
    a1:m |
    d1:m |
    bes2 d2:7sus4 |
    g2 d2:7sus4 |
    g2 d2:7sus4 |
    g2 d2:7sus4 |
    g2 d2:m |
    g2 g2:6sus4 |
    g1 |
    c1:9 |
    c1:9 |
    c1:9 |
    d1:m9 |
  }
}

sopranoDyn = {
  \tempomark
  s1*8\mp |

  % verse
  s1*10\mf |

  % chorus
  s1*16\mf |
}

sopranoNotes = {
  \repeat unfold 4 { e4 d8 g, e'4 d8 g, | e'4 d8 a e'4 d8 a | }

  \repeat volta 3 {
    % verse
    r8. c16 c8 c b16 c8. c4 |
    r8. c16 c8 c c d d4 |
    r4 d8 d16 e f e8. d4 |
    r8. d16 d8. e16 f8. e16 d4 |
    r8. c16 c8 c b16 c8. c8. c16 |
    c8. d16 d16 d8. c8. d16 d4 |
    r4 d8 d16 e f8. e16 d8 c~ |
    c4 a'8. a16 a a a( g) f4 |
    g1~ |
    g2 r

    % chorus
    e4 g~ g e8 c |
    a'8. a16 a8 g f4 f8 e |
    d2~ d8 d8 e f |
    e4 e8. d16 c4 d8 e |
    f2~ f8 f8 e d |
    f8 f f g a8. g16 g8 f |
    g4. d8 a'8. g16 g8. f16 |
    g4. d8 a'8. g16 g8 f |
    g4. d8 a'8. g16 g8 f |
    g4. e8 f8 e f g~ |
    g4 g4~ g2~ |
    g4 d8 e f e d8. c16 |
    c1~ |
    c1~ |
    c1~ |
    c1 |
  }
}

altoDyn = {
  s1*8\mp |

  % verse
  s1*10\mp |

  % chorus
  s1*16\mf |
}

altoNotes = {
  \repeat unfold 4 { g1 | a1 | }

  \repeat volta 3 {
    % verse
    e1 |
    a1 |
    bes1 |
    a1 |
    e1 |
    f1 |
    bes1 |
    g'1 |
    d2 e2 |
    d1 |

    % chorus
    c4 e~ e c8 g |
    f'8 f f e d4 d8 c |
    b2~ b8 b8 c d |
    c4 c8 b a4 b8 c |
    d2~ d8 d8 c b |
    d8 d d e f8. e16 e8 d |
    d4. b8 f'8. e16 e8 d |
    d4. b8 f'8. e16 e8 d |
    d4. b8 f'8. e16 e8 d |
    d4. c8 d8 c d e |
    d2 e |
    d4 b8 c d c b8. g16 |
    g1 |
    a1 |
    g1~ |
    g1 |
  }
}

tenorDyn = {
  s1*8\mp |

  % verse
  s1*10\mp |

  % chorus
  s1*16\mf |
}

tenorNotes = {
  \repeat unfold 4 { e1 | d1 | }

  \repeat volta 3 {
    % verse
    c1 |
    f1 |
    f1 |
    f1 |
    c1 |
    a1 |
    d1 |
    a'1 |
    a2 g2 |
    a1 |

    % chorus
    g4 c~ c g8 e |
    c'8 c c b a4 a8 g |
    g2~ g8 g8 g a |
    a4 a8 g e4 g8 g |
    a2~ a8 a8 g f |
    bes8 bes bes c d8. d16 d8 bes |
    b4. g8 c8. c16 c8 a |
    b4. g8 c8. c16 c8 a |
    b4. g8 c8. c16 c8 a |
    b4. g8 c8 b c c |
    b2 c |
    b4 g8 g b g g8. f16 |
    e1 |
    f1 |
    e1~ |
    e1 |
  }
}

bassDyn = {
  s1*8\mp |

  % verse
  s1*10\mp |

  % chorus
  s1*16\mf |
}

bassNotes = {
  \repeat unfold 4 { c1 | f1 | }

  \repeat volta 3 {
    % verse
    a,1 |
    d1 |
    d1 |
    d1 |
    a1 |
    d1 |
    f1 |
    d1 |
    g,2 c2 |
    b1 |

    % chorus
    c1 |
    f4. f8 f e d4 |
    g,1 |
    a1 |
    d1 |
    f2 d2 |
    g,2 d'2 |
    g,2 d'2 |
    g,2 d'2 |
    g,2 d'2 |
    g,2 c2 |
    g1 |
    c1 |
    f1 |
    c1~ |
    c1 |
  }
}

stanzaFirst = \lyricmode {
  \skip1*8 |

  % verse
  \set stanza = "1. "
  \skip8 You8 were a hol- low look4 |
  \skip8 With8 hor- ror in your hands4 |
  \skip8 You8 were a ma- gic mind4 |
  \skip8 With8 art at your com- mand4 |
  \skip8 You8 were an in- no- cent
  With | all8 the les- sons still to learn4 |
  \skip8 You8 went aw- ay from me I |
  know8 you ne- ver can4 re- |
  turn1 |
  \skip1 |

  % chorus
  Ed-4 ward,2 I8 am | danc-8 ing in your snow4
  Ev-8 en | though2 \skip8 you8 can- not  | see4 me8 to- night4
  As8 the | light2 \skip8 and8 fra- gile | crys-8 tals
  Touch8 the lines8. up-16 on8 my | face4 \skip8
  And8 melt8. am-16 ong8 the | tears4
  I'm4 dan-8. cing16 here8 for | you4
  In4 spite8. of16 all8 my | fears4
  The4 love8. has16 seen8 me | through2 \skip2 |
  \skip4 I8 am dan- cing here4 | for4 you2. | \skip1 | \skip1 | \skip1 |
}

stanzaOthers = \markup {
  \fill-line {
    \hspace #0.1
    \column {
      \line { \bold "2."
        \column {
          "You wore your cookie heart"
          "Upon your sleeve for me"
          "I started trembling when"
          "You finally let me see"
          "You were a shining knight"
          "With gentle soul and flashing steel"
          "Until that winter night"
          "When only rage was left to feel"
        }
      }
    }
    \hspace #0.1
    \column {
      \line { \bold "3."
        \column {
          "And in my mind tonight"
          "I see you climb the stair"
          "I see your scissor-hands"
          "Caress the ice with care"
          "And as the crystal fragments"
          "Melt upon the midnight skies"
          "I'm dancing once again"
          "With teardrops in my eyes"
        }
      }
    }
    % can be removed if page space is tight
    \hspace #0.1
  }
}


% final assembly for the scores to use

outline     = \pageMarks
chordsPart  = \relative c'' { << \scoreConfig \chordsNotes >> }
sopranoPart = \relative c'' { << \scoreConfig \sopranoNotes \sopranoDyn >> }
sopranoMidi = \relative c'' { << \scoreConfig \sopranoNotes \sopranoDyn >> }
altoPart    = \relative c'' { << \scoreConfig \altoNotes \altoDyn >> }
altoMidi    = \relative c'' { << \scoreConfig \altoNotes \altoDyn >> }
tenorPart   = \relative c'  { << \scoreConfig \tenorNotes \tenorDyn >> }
tenorMidi   = \relative c'  { << \scoreConfig \tenorNotes \tenorDyn >> }
bassPart    = \relative c'  { << \scoreConfig \bassNotes \bassDyn >> }
bassMidi    = \relative c'  { << \scoreConfig \bassNotes \bassDyn >> }
lyricPart   = \stanzaFirst
stanzaPart  = \stanzaOthers
rightPart   = << \clef treble \outline \partCombine \sopranoPart \altoPart >>
leftPart    = << \clef bass \partCombine \tenorPart \bassPart >>
concertKey  = c
keyCB       = c,,
keyCT       = c
keyFT       = f
keyBT       = bes,
keyET       = ees
