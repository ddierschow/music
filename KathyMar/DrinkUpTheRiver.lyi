\include "layout.lyi"

tempomark = { \tempo 4 = 80 }

SongHeader = \header {
  title = "Drink Up the River"
  composer = "Words and music by Kathy Mar"
  arranger = \markup { \italic "arr. Dean Dierschow" }
  copyright = \markup { \teeny "Words and music (c) 1988 by Kathy Mar.  Arrangement (c) 2024 by Dean Dierschow" }
  instrument = \instrument
  meter = "Moderately"
  footer = ""
  tagline = ""
}

scoreConfig = {
  #(set-accidental-style 'modern)
  \override MultiMeasureRest.expand-limit = #2
  \override Score.PaperColumn.keep-inside-line = ##t
  \override Score.NonMusicalPaperColumn.keep-inside-line = ##t
  \time 4/4
  \key d \major
}

pageMarks = {
  s1*4 |

  \repeat volta 4 {
    \mark \markup \bold "Verse"
    s1*16 |

    \mark \markup \bold "Chorus"
    s1*7 |
  }
  \alternative {
    {
      s1*2 |
      \time 2/4
      s2 |
      \time 4/4
    }
    {
      s1*9 |
    }
  }

  s1*2 |
  \bar "|."
}

