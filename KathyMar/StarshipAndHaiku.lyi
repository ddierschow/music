\include "layout.lyi"

tempomark = { \tempo 4 = 80 }

SongHeader = \header {
  title = "Starship and Haiku"
  composer = "Words and music by Kathy Mar"
  arranger = \markup { \italic "arr. Dean Dierschow" }
  copyright = \markup { \teeny "Words and music (c) 1984 by Kathy Mar.  Arrangement (c) 2024 by Dean Dierschow" }
  instrument = \instrument
  meter = "Andante"
  footer = ""
  tagline = ""
}

scoreConfig = {
  #(set-accidental-style 'modern)
  \override MultiMeasureRest.expand-limit = #2
  \override Score.PaperColumn.keep-inside-line = ##t
  \override Score.NonMusicalPaperColumn.keep-inside-line = ##t
  \time 6/8
  \key g \major
}

pageMarks = {
  s2.*4 |

  \repeat volta 3 {
    \mark \markup \bold "Verse"
    s2.*20 |

    \mark \markup \bold "Chorus"
    s2.*13 |
  }

  s2.*2 |
  \bar "|."
}

chordsNotes = \chordmode {
  g4. c4.:9 | g4. c4.:9 | g4. c4.:9 | g4. g4. |

  \repeat volta 3 {
    d2.:7sus4 | d2.:7sus4 | g4. c4.:9 | g2. |
    d2.:7sus4 | d2.:7sus4 | g4. c4.:9 | g2. |
    a2.:m | d2. | e2.:m | e2.:m |
    d2.:7sus4 | g2. | d2.:7sus4 | g2. |
    c2.:9 | g2. | d2.:7sus4 | g2. |

    a2.:m | d2. | e2.:m | c2. |
    a2.:m | d2. | e2.:m | d2.:7sus4 |
    g4. c4.:9 | g4. c4.:9 | g4. c4.:9 | g2. | g2. |
  }
}

sopranoDyn = {
  s2.\mp |
  s2.*3 |

  s2.\mp |
  s2.*19 |

  s2.\mf |
  s2.*12 |

  s2.*2 |
}

sopranoNotes = {
  \tempomark

  R2.*4 |

  \repeat volta 3 {
    % verse
    a8 a8. a16 a8 a b |
    c8 b a b a g |
    d2.~ |
    d4. r4 d8 |
    d'8 d d d c b |
    c8 b a b a g |
    b8 d4( \grace e8 d4. |
    \grace e8 d8 \grace e8 d4) r4. |
    a8 a a a a a |
    a8 a a a g fis |
    e2.~ |
    e4. r4. |
    a8 a a a g a |
    b8 d d d4. |
    a8 a a a g a |
    b8 d d d4. |
    a8 a a a g a |
    b8 a g d b c |
    d2.~ |
    d4. r4. |

    % chorus
    a'8 a g a e4 |
    fis8 e16 fis8 e16 fis8 e16 fis8. |
    g4 fis8 e4 d8 |
    e2. |
    a8 a g a e e8 |
    fis8. fis8 e16 fis8 e16 fis8. |
    g4 g8 g4 a8 |
    a2.( |
    g2.)~ |
    g2.~ |
    g2.~ |
    g2. |
    r2. |
  }

  % coda
  R2. |
}

