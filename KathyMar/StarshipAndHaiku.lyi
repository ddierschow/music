stanzaFirst = \lyricmode {
  \skip2.*4 |

  \set stanza = "1. "
  I8 am the flaw in the | tea- bowl I will not dance | death2. | \skip2. |
  I8 will not lie down here | in peace And re- lease my | last breath2 \skip8 | \skip2. |
  All8 of our hopes have been | cast on the reefs and are | gone2. | \skip2. |
  Still8 my salt blood rea- ches | out for the sky4. | Still8 my warm song tou- ches | notes clear and high4. |
  Out-8 ward I go and I | know I will fly a new | dawn2. | \skip2. |

  Star-8 ship and Hai- ku4 |
  Dy-8 ing16 hate8 and16 li-8 ving16 love8. |
  Reach4 be-8 yond4 our8 | sin2. |
  Star-8 ship and Hai- ku One |
  last8 flawed8 re-8 min- der of |
  All4 we8 might4 have8 | been2. | \skip2.*5 |
}

stanzaOthers = \markup {
  \fill-line {
    \hspace #0.1
    \column {
      \line { \bold "2."
        \column {
          "I am a discord in deathsong I cannot be still"
          "I am an infinite paean a permanent trill"
          "I am a leap to the stars I am song to the sky"
          "Always I shun the bleak burial grounds"
          "Always I listen for life's vibrant sounds"
          "Always my hollow-reed heartbeat resounds with its cry"
        }
      }
      \vspace #1.0
      \line { \bold "3."
        \column {
          "(Repeat first verse)"
        }
      }
      \vspace #1.5
      "Note:  If you happen to have any whales handy, encourage them introduce the song and join in throughout the performance."
    }
  }
}


% final assembly for the scores to use

outline     = \pageMarks
chordsPart  = \relative c    { << \scoreConfig \chordsNotes >> }
sopranoPart = \relative c''' { << \scoreConfig \sopranoNotes \sopranoDyn >> }
sopranoMidi = \relative c''  { << \scoreConfig \sopranoNotes \sopranoDyn >> }
altoPart    = \relative c''' { << \scoreConfig \altoNotes \altoDyn >> }
altoMidi    = \relative c''  { << \scoreConfig \altoNotes \altoDyn >> }
tenorPart   = \relative c''  { << \scoreConfig \tenorNotes \tenorDyn >> }
tenorMidi   = \relative c'   { << \scoreConfig \tenorNotes \tenorDyn >> }
bassPart    = \relative c''  { << \scoreConfig \bassNotes \bassDyn >> }
bassMidi    = \relative c'   { << \scoreConfig \bassNotes \bassDyn >> }
lyricPart   = \stanzaFirst
stanzaPart  = \stanzaOthers
rightPart   = << \clef treble \outline \partCombine \sopranoPart \altoPart >>
leftPart    = << \clef bass \partCombine \tenorPart \bassPart >>
concertKey  = c
keyCB       = c,,
keyCT       = c
keyFT       = f,
keyBT       = bes,
keyET       = ees
